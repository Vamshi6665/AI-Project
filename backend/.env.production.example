# Production template for EC2. Don't edit by hand: run  bash infra/ec2/make_env.sh
# which copies this to backend/.env and fills in the REPLACE_ values with generated secrets.
ENVIRONMENT=prod
LOG_LEVEL=INFO
CORS_ORIGINS=REPLACE_PUBLIC_URL

JWT_SECRET=REPLACE_JWT_SECRET
JWT_EXPIRE_MINUTES=60
DEMO_USERNAME=demo
DEMO_PASSWORD=REPLACE_DEMO_PASSWORD

MAX_UPLOAD_MB=10
MAX_PAGES=30
MAX_CHARS_TO_LLM=24000

# sagemaker (gpt-oss-20b endpoint) or bedrock (fallback while GPU quota is pending)
LLM_PROVIDER=REPLACE_LLM_PROVIDER
# 2048 keeps a SageMaker call well inside the 60-second real-time limit
LLM_MAX_TOKENS=2048
LLM_REASONING_EFFORT=low

AWS_REGION=REPLACE_AWS_REGION
SAGEMAKER_ENDPOINT_NAME=clinical-ai-gptoss-20b
BEDROCK_MODEL_ID=openai.gpt-oss-20b-1:0

# No AWS keys here: the EC2 instance role provides credentials.
