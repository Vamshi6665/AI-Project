# Copy to backend/.env for local runs:  cp .env.example .env
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Auth - change both before deploying. Generate a secret with:  openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE_MINUTES=60
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# Limits
MAX_UPLOAD_MB=10
MAX_PAGES=30
MAX_CHARS_TO_LLM=24000

# LLM provider: mock | openai | sagemaker | bedrock
LLM_PROVIDER=mock
LLM_MAX_TOKENS=4096
LLM_REASONING_EFFORT=low

# Day 1: OpenAI directly
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Day 2: AWS (on EC2 the instance role supplies credentials - never put access keys here)
AWS_REGION=us-east-1
SAGEMAKER_ENDPOINT_NAME=clinical-ai-gptoss-20b
BEDROCK_MODEL_ID=openai.gpt-oss-20b-1:0
